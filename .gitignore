# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/

# --- build output (regenerate with PyInstaller) ---
build/
dist/
*.exe

# --- personal / machine state: never commit these ---
savegame.txt
gamble_meta.txt
gamble_settings.txt
share/
backups/

# --- installer output ---
installer/Output/

# --- editors / OS ---
.vscode/
.idea/
Thumbs.db
Desktop.ini

# --- lint cache (ruff writes its own .gitignore inside, this is belt and braces) ---
.ruff_cache/
